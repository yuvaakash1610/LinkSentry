APP_NAME=LinkSentry Backend
APP_VERSION=1.0.0
ENVIRONMENT=production
API_PREFIX=/api

# ML model paths (leave empty to use rule-based engine)
TEXT_MODEL_PATH=
TEXT_VECTORIZER_PATH=
URL_MODEL_PATH=

# Risk fusion weights (must sum to 1.0)
TEXT_WEIGHT=0.45
URL_WEIGHT=0.35
RULE_WEIGHT=0.20

# Input validation
MAX_TEXT_LENGTH=10000
MAX_URL_LENGTH=4096

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE=60/minute

# CORS — allow all origins so the Android app can connect from any IP
ALLOWED_ORIGINS=*

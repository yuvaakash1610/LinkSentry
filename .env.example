APP_NAME=LinkSentry Backend
APP_VERSION=1.0.0
ENVIRONMENT=development
API_PREFIX=/api

# Paths to trained ML artifacts (optional / empty during initial phase)
TEXT_MODEL_PATH=
TEXT_VECTORIZER_PATH=
URL_MODEL_PATH=

# Risk fusion weights (must sum approximately to 1.0)
TEXT_WEIGHT=0.45
URL_WEIGHT=0.35
RULE_WEIGHT=0.20

# Input validation constraints
MAX_TEXT_LENGTH=10000
MAX_URL_LENGTH=4096

# Rate limiting configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE=60/minute

# CORS configuration (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

